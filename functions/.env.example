# Copy to functions/.env and edit. These are NOT secrets (secrets go through `firebase functions:secrets:set`).
# Comma-separated list of website origins that may call the API (no path, no trailing slash).
ALLOWED_ORIGINS=https://drsudhakar.github.io,http://localhost:8000
# Open model used as the empathy "judge" when the visitor does not pick one.
DEFAULT_JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
# Where your functions run (asia-south1 = Mumbai, us-central1 = Iowa, europe-west1 = Belgium).
FUNCTION_REGION=asia-south1

# ---- Paid access for the LLM empathy checker and the EEG lab (functions/billing.py) ----
# Google account e-mail(s) that may approve payments on admin.html (comma-separated).
ADMIN_EMAILS=your.name@gmail.com
# Free minutes each signed-in user gets per calendar month.
FREE_MINUTES_PER_USER=5
# Total free minutes for the WHOLE site per month. Keep it below Google's free tier
# (about 25 hours of the 2-CPU EEG service; 900 minutes = 15 hours leaves a safety margin).
FREE_POOL_MINUTES=900
# Price after the free minutes, in rupees per minute.
PRICE_PER_MINUTE_INR=1
# Most minutes one person may use per day.
DAILY_CAP_MINUTES=120
# Most minutes that can be bought in one payment.
MAX_PURCHASE_MINUTES=600
